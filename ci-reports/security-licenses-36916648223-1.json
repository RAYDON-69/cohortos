      {
        "name": "chromadb",
        "version": "1.1.1",
        "vulns": [
          {
            "id": "PYSEC-2026-311",
            "fix_versions": [],
            "aliases": [
              "CVE-2026-45829",
              "GHSA-f4j7-r4q5-qw2c"
            ],
            "description": "A pre-authentication, code injection vulnerability in version 1.0.0 or later of the ChromaDB Python project allows an unauthenticated attacker to run arbitrary code on the server by sending a malicious model repository and trust_remote_code set to true in the\u00a0/api/v2/tenants/{tenant}/databases/{db}/collections endpoint."
          },
          {
            "id": "PYSEC-2026-311",
            "fix_versions": [],
            "aliases": [
              "CVE-2026-45829",
              "GHSA-f4j7-r4q5-qw2c"
            ],
            "description": "A pre-authentication, code injection vulnerability in version 1.0.0 or later of the ChromaDB Python project allows an unauthenticated attacker to run arbitrary code on the server by sending a malicious model repository and trust_remote_code set to true in the\u00a0/api/v2/tenants/{tenant}/databases/{db}/collections endpoint."
          },
          {
            "id": "PYSEC-2026-3814",
            "fix_versions": [],
            "aliases": [
              "GHSA-36p7-vc44-83pf",
              "CVE-2026-45833"
            ],
            "description": "A code injection vulnerability in version 0.4.17 or later of the ChromaDB Python project allows an authenticated attacker to run arbitrary code on the server by sending a malicious model repository and trust_remote_code set to true in the\u00a0/api/v2/tenants/default_tenant/databases/default_database/collections/{collection_id} if they have the UPDATE_COLLECTION permission."
          },
          {
            "id": "PYSEC-2026-3815",
            "fix_versions": [],
            "aliases": [
              "GHSA-xph7-9rjv-w5fr",
              "CVE-2026-45831"
            ],
            "description": "The SimpleRBACAuthorizationProvider authorization provider in versions 0.5.0 or later of the ChromaDB Python project evaluates whether a user holds a given permission but never checks which tenant, database, or collection that permission applies to allowing users to perform cross tenant actions."
          },
          {
            "id": "PYSEC-2026-3813",
            "fix_versions": [],
            "aliases": [
              "GHSA-2wm9-hf6c-p5cr",
              "CVE-2026-45830"
            ],
            "description": "A lack of authorization validation in version 0.4.17 or later of the ChromaDB Python project allows any authenticated users to arbitrarily read, write, update, or delete data in any tenant's collection regardless of which tenant they belong to."
          }
        ]
