{
  "name": "cohortos-frontend",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "a11y": "vitest run --reporter=verbose src/**/*.a11y.test.tsx",
    "electron": "COHORTOS_DEV=1 electron .",
    "audit:tokens": "node -e \"const fs=require('fs');const path=require('path');function walk(d,a=[]){for(const f of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,f.name);if(f.isDirectory()&&f.name!=='node_modules')walk(p,a);else if(/\\.(tsx|ts|css)$/.test(f.name)&&!p.endsWith('tokens.css'))a.push(p)}return a}const hex=/#[0-9A-Fa-f]{3,8}/g;let bad=[];for(const f of walk('src')){const t=fs.readFileSync(f,'utf8');const m=t.match(hex);if(m)bad.push(f+': '+m.join(','))}if(bad.length){console.error(bad.join('\\n'));process.exit(1)}console.log('token audit clean')\"",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "framer-motion": "^11.15.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "pdfjs-dist": "^4.10.38",
    "plyr": "^3.7.8",
    "photoswipe": "^5.4.4",
    "papaparse": "^5.4.1",
    "@excalidraw/excalidraw": "^0.18.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^3.1.4",
    "axe-core": "^4.10.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.1.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.1.4",
    "vitest-axe": "^0.1.0",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.cohortos.desk",
    "productName": "CohortOS",
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/",
        "to": "bin",
        "filter": [
          "cohortos-api",
          "cohortos-api.exe"
        ]
      },
      {
        "from": "../api",
        "to": "backend/api",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../services",
        "to": "backend/services",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../models",
        "to": "backend/models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RAYDON-69/cohortos.git"
  },
  "overrides": {
    "glob": "^10.4.5",
    "tar": "^7.4.3",
    "lodash-es": "^4.18.1",
    "nanoid": "3.3.19",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.19",
      "lodash-es": "^4.18.1",
      "sass": "1.77.8",
      "chokidar": "3.6.0",
      "braces": "3.0.3"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "3.3.19"
    },
    "braces": "3.0.3",
    "chokidar": "3.6.0",
    "uuid": "^11.1.1",
    "sass": "1.77.8",
    "**/braces": "3.0.3",
    "**/chokidar": "3.6.0",
    "**/sass": "1.77.8"
  }
}
