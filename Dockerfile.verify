# Portable proof image — 4GB+ RAM recommended
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git build-essential \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dev.txt
COPY . .
ENV COHORTOS_ENV=test \
    COHORTOS_JWT_SECRET=docker-verify-secret-not-for-prod32 \
    COHORTOS_TEST_EXPOSE_OTP=1 \
    COHORTOS_SKIP_MODEL_DOWNLOAD=1 \
    NODE_OPTIONS=--max-old-space-size=600
CMD ["bash", "scripts/final_verify.sh", "--low-mem"]
