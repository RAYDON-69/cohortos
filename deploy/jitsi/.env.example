# Copy to .env — never commit secrets
CONFIG=./jitsi-config
HTTP_PORT=8000
HTTPS_PORT=8443
TZ=Asia/Dhaka
PUBLIC_URL=https://meet.yourcentre.example
ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt
JWT_APP_ID=cohortos
JWT_APP_SECRET=change-me-long-random-secret
JWT_ACCEPTED_ISSUERS=cohortos
JWT_ACCEPTED_AUDIENCES=cohortos
ENABLE_HTTP_REDIRECT=1
DISABLE_HTTPS=0
